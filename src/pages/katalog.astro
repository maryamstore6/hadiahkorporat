---
import Base from '../layouts/Base.astro';
import { SITE, produkSemua, kategoriSemua, pautan, duit, GANDA_CORET } from '../lib/site.js';

const kategori = kategoriSemua();

// Data ringan untuk penapisan di pihak pelanggan
const ringan = produkSemua.map((p) => ({
  s: p.slug,
  n: p.nama,
  k: p.kategori,
  h: p.harga,
  hm: p.harga_max || 0,   /* harga maksimum (0 = satu harga sahaja) */
  c: p.sku || '',
  g: p.gambar || '',
}));
---
<Base tajuk="Katalog" huraian={`Cari ${produkSemua.length} produk hadiah korporat mengikut kategori dan bajet. Harga seunit, MOQ ${SITE.moq} pcs.`}>
  <div class="wrap">
    <nav class="crumb" aria-label="Laluan"><a href={pautan('/')}>Utama</a> / Katalog</nav>
    <div class="section-head" style="margin-top:1.2rem">
      <div>
        <p class="eyebrow">Katalog</p>
        <h1 style="font-size:clamp(1.9rem,4vw,2.8rem)">{produkSemua.length} produk hadiah korporat</h1>
        <p>Semua harga seunit. MOQ {SITE.moq} pcs setiap reka bentuk. Cetakan logo dikira berasingan.</p>
      </div>
    </div>

    <div class="filters">
      <div class="filter-row">
        <label class="sr" for="cari">Cari</label>
        <input class="input" id="cari" type="search" placeholder="Cari nama produk atau kod…" style="flex:1;min-width:220px" />
        <label class="sr" for="urut">Susun</label>
        <select class="input" id="urut">
          <option value="relevan">Paling relevan</option>
          <option value="murah">Harga: rendah ke tinggi</option>
          <option value="mahal">Harga: tinggi ke rendah</option>
          <option value="az">Nama: A–Z</option>
        </select>
      </div>
      <div class="filter-row filter-budget">
        <span class="count-line filter-label">Bajet seunit:</span>
        <input class="input" id="min" type="number" min="0" placeholder="Min RM" />
        <span class="count-line filter-dash">—</span>
        <input class="input" id="maks" type="number" min="0" placeholder="Maks RM" />
        <button class="card-btn" id="reset" type="button">Set semula</button>
      </div>
      <div class="chips" id="chips">
        <button type="button" data-kat="" aria-pressed="true">Semua kategori</button>
        {kategori.map((k, i) => (
          <button type="button" data-kat={k.nama} aria-pressed="false" data-awal={i < 12 ? '1' : '0'} hidden={i >= 12}>
            {k.nama}<span class="chip-n">{k.bilangan}</span>
          </button>
        ))}
        <button type="button" id="lagi-kat" class="chip-more">Lagi {kategori.length - 12} kategori ↓</button>
      </div>
      <div class="count-line" id="kiraan">Memuatkan…</div>
    </div>

    <div class="grid-prod" id="grid"></div>
    <div style="text-align:center;padding:2.5rem 0 4rem">
      <button class="btn btn-ghost" id="lagi" type="button">Tunjuk lagi</button>
    </div>
  </div>

  <script is:inline type="application/json" id="data-produk" set:html={JSON.stringify(ringan)}></script>
  <script is:inline define:vars={{ BASE: import.meta.env.BASE_URL.replace(/\/$/, ''), MOQ: SITE.moq, GANDA: GANDA_CORET }}>
    const SEMUA = JSON.parse(document.getElementById('data-produk').textContent);
    const PALET = [['#0B5D4F','#0E7A66'],['#1F3A5F','#2C5282'],['#6B3F2A','#8A5638'],['#3D2B56','#54397A'],['#7A2E3B','#9C3C4C'],['#1E4D4A','#2A6B66'],['#4A4A22','#6B6B31'],['#2E3A2E','#455445'],['#553322','#6E442D'],['#243B4A','#315160'],['#5A2D5A','#773C77'],['#3A3A3A','#525252']];

    const el = (id) => document.getElementById(id);
    const negeri = { q: '', kat: '', min: null, maks: null, urut: 'relevan', tunjuk: 48 };

    function warna(s) { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return PALET[h % PALET.length]; }
    function inisial(n) {
      const b = n.replace(/\(.*?\)/g, ' ').replace(/^(the|dan|and|with|for|fully|in|1|2|3)\s+/i, '').trim();
      const w = b.split(/[\s\-–—/]+/).filter((x) => /[a-zA-Z]/.test(x));
      return (w.slice(0, 2).map((x) => x[0].toUpperCase()).join('') || 'HK');
    }
    function duit(n) { return 'RM' + Number(n).toLocaleString('ms-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    /* Slug kategori — sama logik dengan slugify() di site.js. */
    function slugKat(s) {
      return (s || '').toLowerCase().replace(/&/g, 'and')
        .replace(/[^a-z0-9]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
    }
    /* Potong pada sempang perkataan, bukan tengah perkataan. */
    function pendek(s) {
      if (s.length <= 20) return s;
      const potong = s.slice(0, 20);
      const spasi = potong.lastIndexOf(' ');
      return (spasi > 8 ? potong.slice(0, spasi) : potong).trim() + '…';
    }

    function tapis() {
      // Normalisasi carian:
      //  - ruang berlebihan dalaman ("aluminium  plaque" -> "aluminium plaque")
      //  - sengkang: data guna en-dash (–) pada 31 nama, jadi taip '-' pun kena jumpa
      function teks(s) {
        return (s || '').toLowerCase().replace(/[\u2013\u2014]/g, '-').replace(/\s+/g, ' ');
      }
      // Kata kunci mesti dinormalisasi dengan fungsi SAMA seperti nama produk,
      // jika tidak '–' dalam carian tidak akan jumpa '-' dalam data (dan sebaliknya).
      const q = teks(negeri.q.trim());
      let senarai = SEMUA.filter((p) => {
        if (negeri.kat && p.k !== negeri.kat) return false;
        // Produk berjulat (h hingga hm) mesti dibandingkan dengan SELURUH julat,
        // bukan minimum sahaja. Jika tidak, 'min=100' membuang produk yang ada
        // varian RM100+, dan 'maks=60' menyertakan produk yang variannya RM96.
        const lo = p.h;
        const hi = p.hm > p.h ? p.hm : p.h;
        if (negeri.min !== null && !(hi > 0 && hi >= negeri.min)) return false;
        if (negeri.maks !== null && !(lo > 0 && lo <= negeri.maks)) return false;
        if (q && !(teks(p.n).includes(q) || teks(p.c).includes(q))) return false;
        return true;
      });
      if (negeri.urut === 'murah') senarai.sort((a, b) => (a.h || 1e9) - (b.h || 1e9));
      else if (negeri.urut === 'mahal') senarai.sort((a, b) => b.h - a.h);
      else if (negeri.urut === 'az') senarai.sort((a, b) => a.n.localeCompare(b.n));
      return senarai;
    }

    function kad(p) {
      const [c1, c2] = warna(p.k);
      // Julat harga: kad mesti tunjuk had atas, bukan minimum sahaja.
      // Halaman produk dan ProductCard.astro sudah tunjuk julat — katalog
      // adalah satu-satunya tempat yang kehilangannya (42 produk berjulat,
      // sebahagian bawah nyata sehingga RM42).
      const harga = p.h > 0
        ? (p.hm > p.h ? `${duit(p.h)} – ${duit(p.hm)}` : duit(p.h))
        : 'Sebut harga';
      const isiMedia = p.g
        ? (() => {
            const b = p.g.replace(/\.webp$/, '');
            const set = `${BASE}${b}-300.webp 300w, ${BASE}${b}-600.webp 600w, ${BASE}${p.g} 900w`;
            return `<img src="${BASE}${p.g}" srcset="${set}" sizes="(max-width: 640px) 45vw, (max-width: 1100px) 30vw, 240px" alt="${p.n.replace(/"/g, '&quot;')}" loading="lazy" decoding="async" width="440" height="330">`;
          })()
        : `<span class="ph">${inisial(p.n)}</span>`;
      return `<article class="card">
        <a class="card-media" href="${BASE}/produk/${p.s}/" ${p.g ? '' : `style="background:linear-gradient(135deg,${c1},${c2})"`} aria-label="${p.n}">
          <span class="tag">${pendek(p.k)}</span>
          ${isiMedia}
        </a>
        <div class="card-body">
          <h3 class="card-name"><a href="${BASE}/produk/${p.s}/">${p.n}</a></h3>
          <div class="card-meta">${p.c ? 'Kod: ' + p.c : ''}</div>
          <div class="card-foot">
            <div class="card-price">${p.h > 0 && !(p.hm > p.h) ? `<s class="coret">${duit(p.h * GANDA)}</s>` : ''}${harga}<small>${p.hm > p.h ? 'seunit, ikut pilihan' : 'seunit'} · MOQ ${MOQ}</small></div>
            <button class="card-btn" type="button" data-tambah="${p.s}" data-nama="${p.n.replace(/"/g, '&quot;')}" data-harga="${harga}" data-sku="${p.c}">Tambah ke senarai</button>
          </div>
        </div>
      </article>`;
    }

    function lukis() {
      const senarai = tapis();
      const potong = senarai.slice(0, negeri.tunjuk);
      el('grid').innerHTML = potong.length ? potong.map(kad).join('') : '<div class="empty" style="grid-column:1/-1"><h3>Tiada produk sepadan</h3><p>Cuba luaskan julat bajet atau buang penapis.</p></div>';
      el('kiraan').textContent = senarai.length
        ? `Menunjuk ${potong.length} daripada ${senarai.length} produk`
        : 'Tiada produk sepadan';
      el('lagi').style.display = senarai.length > negeri.tunjuk ? '' : 'none';
      if (window.__selepasLukis) window.__selepasLukis();
    }

    // Muat keadaan dari URL
    const sp = new URLSearchParams(location.search);
    if (sp.get('q')) { negeri.q = sp.get('q'); el('cari').value = sp.get('q'); }
    if (sp.get('kategori')) {
      // Terima nama penuh ('Eco Bag') DAN bentuk slug ('eco-bag') — semua
      // pautan lain di laman ini guna slug, jadi param ini pun mesti tahan.
      const diminta = sp.get('kategori');
      const nama = [...new Set(SEMUA.map((p) => p.k))];
      negeri.kat = nama.includes(diminta)
        ? diminta
        : (nama.find((n) => slugKat(n) === slugKat(diminta)) || '');
    }
    const nombor = (v) => { const n = Number(v); return Number.isFinite(n) && n >= 0 ? n : null; };
    if (nombor(sp.get('maks')) !== null) { negeri.maks = nombor(sp.get('maks')); el('maks').value = negeri.maks; }
    if (nombor(sp.get('min')) !== null) { negeri.min = nombor(sp.get('min')); el('min').value = negeri.min; }
    document.querySelectorAll('#chips button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.kat === negeri.kat ? 'true' : 'false'));

    // Debounce 160ms: setiap ketukan dulu membina semula 48 kad DAN menulis
    // semula 1,296 butang 'Tambah ke senarai' (Base.astro). Taip 'aluminium'
    // = 9 bina-semula penuh.
    let pemasaCari = null;
    el('cari').addEventListener('input', (e) => {
      negeri.q = e.target.value;
      negeri.tunjuk = 48;
      clearTimeout(pemasaCari);
      pemasaCari = setTimeout(lukis, 160);
    });
    el('urut').addEventListener('change', (e) => { negeri.urut = e.target.value; lukis(); });
    el('min').addEventListener('input', (e) => { negeri.min = e.target.value === '' ? null : Number(e.target.value); negeri.tunjuk = 48; lukis(); });
    el('maks').addEventListener('input', (e) => { negeri.maks = e.target.value === '' ? null : Number(e.target.value); negeri.tunjuk = 48; lukis(); });
    el('lagi-kat')?.addEventListener('click', (e) => {
      const butang = e.currentTarget;
      const buka = butang.dataset.buka !== '1';
      butang.dataset.buka = buka ? '1' : '0';
      document.querySelectorAll('#chips button[data-awal="0"]').forEach((x) => { x.hidden = !buka; });
      butang.textContent = buka ? 'Tunjuk kurang ↑' : `Lagi ${document.querySelectorAll('#chips button[data-awal="0"]').length} kategori ↓`;
    });

    el('chips').addEventListener('click', (e) => {
      const b = e.target.closest('button[data-kat]'); if (!b) return;
      if (b.hidden) b.hidden = false;
      negeri.kat = b.dataset.kat; negeri.tunjuk = 48;
      document.querySelectorAll('#chips button').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
      lukis();
    });
    el('reset').addEventListener('click', () => {
      negeri.q = ''; negeri.kat = ''; negeri.min = null; negeri.maks = null; negeri.urut = 'relevan'; negeri.tunjuk = 48;
      el('cari').value = ''; el('min').value = ''; el('maks').value = ''; el('urut').value = 'relevan';
      document.querySelectorAll('#chips button').forEach((x) => x.setAttribute('aria-pressed', x.dataset.kat === '' ? 'true' : 'false'));
      lukis();
    });
    el('lagi').addEventListener('click', () => { negeri.tunjuk += 48; lukis(); });

    // Butang "dalam senarai" perlu disegerakkan setiap kali grid dilukis semula
    const asalLukis = window.lukisSelepas;
    window.__selepasLukis = () => { if (window.__segerakSebut) window.__segerakSebut(); };
    lukis();
  </script>
</Base>
