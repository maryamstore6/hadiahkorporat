---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE, produkSemua, warnaProduk, inisial, duit, hargaCoret, teksHarga, pautan, srcset, SAIZ_HERO, slugify } from '../../lib/site.js';

export function getStaticPaths() {
  return produkSemua.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const { c1, c2, sudut } = warnaProduk(p.nama, p.kategori);
const katSlug = slugify(p.kategori);
const serupa = produkSemua
  .filter((x) => x.kategori === p.kategori && x.slug !== p.slug)
  .slice(0, 8);
const hargaTeks = p.harga > 0 ? teksHarga(p) : 'Sebut harga';
---
<Base
  gambar={p.gambar || undefined}
  tajuk={p.nama}
  huraian={`${p.nama}${p.sku && !p.nama.includes(p.sku) ? ` (${p.sku})` : ''} — ${hargaTeks} seunit, MOQ ${SITE.moq} pcs. Cetakan logo & mock-up percuma.`}
>
  <div class="wrap">
    <nav class="crumb" aria-label="Laluan">
      <a href={pautan('/')}>Utama</a> / <a href={pautan('/katalog')}>Katalog</a> /
      <a href={pautan(`/kategori/${katSlug}`)}>{p.kategori}</a> / {p.nama}
    </nav>

    <div class="prod-layout">
      <div class="galeri">
        <div
          class="prod-hero-media"
          id="media-utama"
          style={p.gambar ? undefined : `background:linear-gradient(${sudut}deg,${c1},${c2})`}
        >
          {p.gambar
            ? <img
                id="img-utama"
                src={pautan(p.gambar)}
                srcset={srcset(p.gambar)}
                sizes={SAIZ_HERO}
                alt={p.nama}
                width="900"
                height="900"
                fetchpriority="high"
                decoding="async"
              />
            : <span class="ph">{inisial(p.nama)}</span>}
        </div>

        {(p.gambar && p.galeri && p.galeri.length > 0) && (
          <div class="galeri-thumb" id="galeri-thumb" role="group" aria-label="Gambar lain produk ini">
            <button
              type="button"
              aria-pressed="true"
              data-besar={pautan(p.gambar)}
              data-set={srcset(p.gambar)}
              data-alt={p.nama}
            >
              <img src={pautan(p.gambar.replace(/\.webp$/, '-300.webp'))} alt="" width="68" height="68" loading="lazy" decoding="async" />
            </button>
            {p.galeri.map((g, i) => (
              <button
                type="button"
                aria-pressed="false"
                data-besar={pautan(g)}
                data-set=""
                data-alt={`${p.nama} — gambar ${i + 2}`}
              >
                <img src={pautan(g.replace(/\.webp$/, '-t.webp'))} alt="" width="68" height="68" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}

        {!p.gambar && (
          <p style="font-size:.8rem;color:var(--muted);margin-top:.6rem">
            Gambar sebenar akan dimuatkan oleh pembekal. Jubin di atas ialah pengganti sementara.
          </p>
        )}
      </div>

      <div>
        <p class="eyebrow">{p.kategori}</p>
        <h1 style="font-size:clamp(1.7rem,3.6vw,2.5rem)">{p.nama}</h1>

        <div class="price-box">
          <div class="big">
            {p.harga > 0 && !(p.harga_max > p.harga) && <s class="coret">{duit(hargaCoret(p.harga))}</s>}
            {p.harga > 0 ? teksHarga(p) : hargaTeks}
          </div>
          {p.harga_max > p.harga && (
            <p class="julat-nota">
              Harga bergantung pada pilihan saiz/reka. Julat {duit(p.harga)} – {duit(p.harga_max)} seunit.
            </p>
          )}
          <div class="note">
            {p.harga > 0
              ? `Harga seunit (harga asas produk) untuk MOQ ${SITE.moq} pcs. Cetakan logo dan penghantaran dinyatakan berasingan dalam sebut harga — anda nampak jumlah penuh sebelum membayar.`
              : 'Hubungi kami untuk harga pada bilangan anda.'}
          </div>
        </div>

        <button
          class="btn btn-primary"
          type="button"
          data-tambah={p.slug}
          data-nama={p.nama}
          data-harga={hargaTeks}
          data-sku={p.sku || ''}
          style="width:100%;justify-content:center"
        >Tambah ke senarai sebut harga</button>

        <div style="display:flex;gap:.6rem;margin-top:.6rem">
          <a class="btn btn-ghost btn-sm" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Salam, saya berminat dengan ${p.nama}${p.sku ? ' (' + p.sku + ')' : ''}. Boleh dapatkan sebut harga untuk ${SITE.moq} pcs?`)}`} target="_blank" rel="noopener">Tanya terus di WhatsApp</a>
          <a class="btn btn-ghost btn-sm" href={pautan('/sebut-harga')}>Cara sebut harga</a>
        </div>

        <ul class="prod-specs prod-kos">
          <li class="tajuk-kos"><span>Pecahan kos</span><b></b></li>
          <li>
            <span>Harga seunit</span>
            <b>{p.harga > 0 ? `${teksHarga(p)} × ${SITE.moq} pcs` : 'Sebut harga'}</b>
          </li>
          <li>
            <span>Cetakan logo</span>
            <b>Ikut bilangan &amp; kaedah cetakan — dalam sebut harga</b>
          </li>
          <li>
            <span>Penghantaran</span>
            <b>Ikut lokasi &amp; berat — dalam sebut harga</b>
          </li>
          <li class="jumlah-kos">
            <span>Jumlah penuh</span>
            <b>Dinyatakan sebelum anda bayar</b>
          </li>
        </ul>

        <ul class="prod-specs">
          {p.sku && <li><span>Kod produk</span><b>{p.sku}</b></li>}
          <li><span>Kategori</span><b><a href={pautan(`/kategori/${katSlug}`)}>{p.kategori}</a></b></li>
          {p.jenama && <li><span>Jenama</span><b>{p.jenama}</b></li>}
          <li><span>Kuantiti minimum</span><b>{SITE.moq} pcs</b></li>
          <li><span>Cetakan logo</span><b>Termasuk mock-up percuma</b></li>
          <li><span>Masa siap</span><b>7–14 hari kerja selepas kelulusan</b></li>
        </ul>

        <div class="note-box">
          <b>Penting:</b> harga di atas ialah harga seunit asas. Kos cetakan logo bergantung pada
          kaedah (pad print, silkscreen, UV, sulam) dan bilangan warna. Kami beri sebut harga penuh
          dalam 1 hari kerja.
        </div>
      </div>
    </div>

    {serupa.length > 0 && (
      <section style="padding:1rem 0 4rem;border-top:1px solid var(--line)">
        <h2 style="font-size:1.4rem;margin-top:2rem">Lain-lain dalam {p.kategori}</h2>
        <div class="grid-prod" style="margin-top:1.2rem">
          {serupa.map((x) => <ProductCard p={x} ringkas />)}
        </div>
      </section>
    )}
  </div>
  <script is:inline>
    // Galeri: tukar gambar utama bila thumbnail diklik
    const kotak = document.getElementById('galeri-thumb');
    const utama = document.getElementById('img-utama');
    kotak?.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-besar]');
      if (!b || !utama) return;
      utama.src = b.dataset.besar;
      if (b.dataset.set) utama.srcset = b.dataset.set;
      else utama.removeAttribute('srcset');
      utama.alt = b.dataset.alt || '';
      kotak.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
    });
  </script>
</Base>
