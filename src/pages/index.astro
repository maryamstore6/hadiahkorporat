---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { SITE, produkSemua, kategoriSemua, gambarKategori, pautan, duit } from '../lib/site.js';
import ulasan from '../data/ulasan.json';

const kategori = kategoriSemua();
const teratas = kategori.slice(0, 10);
/* Baris "bawah RM60".
   Dulu ia disusun ikut NAMA tetapi dilabel "Paling laris" - dakwaan yang
   tiada asas kerana kami tiada data jualan. Ia juga memaparkan 3 kad dengan
   nama SAMA (varian warna ECP5566), jadi 3 daripada 8 slot terbazir dan
   pelawat sangka laman rosak. */
const unggul = (() => {
  const nampak = new Set();
  const keluar = [];
  for (const p of [...produkSemua].sort((a, b) => a.nama.localeCompare(b.nama))) {
    if (!(p.harga > 0 && p.harga < 60)) continue;
    if (nampak.has(p.nama)) continue;      // satu kad sahaja bagi setiap nama
    nampak.add(p.nama);
    keluar.push(p);
    if (keluar.length === 8) break;
  }
  return keluar;
})();
/* Baris "Untuk majlis besar" — hadiah anugerah sahaja.
   Sebelum ini ia ambil 4 produk TERMAHAL tanpa mengira kategori, jadi
   Bath Towel (BT270) RM528 — kesilapan taip pembekal (tuala lain RM23-37)
   — muncul sebagai kad pertama di halaman utama dan merosakkan
   kredibiliti 1,295 harga lain. */
const KATA_ANUGERAH = ['crystal', 'trophy', 'plaque', 'award', 'medal', 'stone', 'resin', 'certificate'];

/* Pengawal harga luar tabii: bandingkan dengan KELUARGA produk (dua patah
   perkataan pertama nama), bukan kategori. Kategori terlalu luas — median
   'Crystal Trophies & Awards' cuma RM60 walaupun ia mengandungi trofi RM290.
   Keluarga menangkap kesilapan taip sebenar: Bath Towel (BT270) RM528
   berbanding 13 tuala lain pada median RM26.40.
   Ambang 6x sengaja longgar — hanya tangkap kes melampau. */
function keluarga(nama) {
  return nama.split(' ').slice(0, 2).join(' ').toLowerCase();
}
const hargaKeluarga = {};
for (const p of produkSemua) {
  if (p.harga > 0) (hargaKeluarga[keluarga(p.nama)] ||= []).push(p.harga);
}
const medianKeluarga = {};
for (const k of Object.keys(hargaKeluarga)) {
  const s = hargaKeluarga[k].sort((a, b) => a - b);
  medianKeluarga[k] = s[Math.floor(s.length / 2)];
}
const berharga = [...produkSemua]
  .filter((p) => p.harga >= 100
    && KATA_ANUGERAH.some((w) => p.kategori.toLowerCase().includes(w))
    && p.harga <= medianKeluarga[keluarga(p.nama)] * 6)
  .sort((a, b) => b.harga - a.harga)
  .slice(0, 4);
const adaHarga = produkSemua.filter((p) => p.harga > 0);
---
<Base huraian={`${produkSemua.length} produk hadiah korporat bercetak logo. Harga seunit, MOQ ${SITE.moq} pcs. Sebut harga dalam 1 hari kerja.`}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{produkSemua.length} produk · {kategori.length} kategori · harga terpampang</p>
        <h1>
          Hadiah korporat, terus dari katalog.
          <em>Harga, MOQ dan gambar — semua terang.</em>
        </h1>
        <p class="hero-lead">
          Jalan dalam katalog dulu. Setiap produk ada harga seunit dan MOQ sendiri,
          tanpa perlu tanya sesiapa. Bila dah jumpa yang sesuai, minta sebut harga —
          siap dalam 1 hari kerja.
        </p>
        <div class="hero-cta">
          <a class="btn btn-lime" href={pautan('/katalog')}>Masuk katalog</a>
          <a class="btn btn-ghost" href={pautan('/sebut-harga')}>Minta sebut harga</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><b>{produkSemua.length}</b><span>Produk tersedia</span></div>
          <div class="hero-stat"><b>Percuma</b><span>Mock-up sebelum cetak</span></div>
          <div class="hero-stat"><b>1 hari</b><span>Sebut harga</span></div>
          <div class="hero-stat"><b>7–14 hari</b><span>Siap selepas kelulusan</span></div>
          <div class="hero-stat"><b>{SITE.moq}</b><span>MOQ (pcs)</span></div>
        </div>
      </div>
      <figure class="hero-gambar">
        <picture>
          <source
            type="image/avif"
            srcset={`${pautan('/hero/hero-480.avif')} 480w, ${pautan('/hero/hero-720.avif')} 720w, ${pautan('/hero/hero-960.avif')} 960w`}
            sizes="(max-width: 900px) 92vw, 480px"
          />
          <source
            type="image/webp"
            srcset={`${pautan('/hero/hero-480.webp')} 480w, ${pautan('/hero/hero-720.webp')} 720w, ${pautan('/hero/hero-960.webp')} 960w`}
            sizes="(max-width: 900px) 92vw, 480px"
          />
          <img
            src={pautan('/hero/hero-960.webp')}
            srcset={`${pautan('/hero/hero-480.webp')} 480w, ${pautan('/hero/hero-720.webp')} 720w, ${pautan('/hero/hero-960.webp')} 960w`}
            sizes="(max-width: 900px) 92vw, 480px"
            alt="Set hadiah korporat: beg, tumbler dan set buku nota bercetak logo, sedia untuk dihantar kepada klien"
            width="960"
            height="960"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </section>

  <!-- MARQUEE: jalur kepercayaan bergerak -->
  <div class="marquee" aria-label="Kelebihan kami">
    <div class="marquee-track">
      {[0, 1].map((n) => (
        <div class="marquee-group" aria-hidden={n === 1 ? 'true' : undefined}>
          <span class="strip-item">Harga seunit terpampang — kos cetakan dinyatakan awal</span>
          <span class="marquee-dot" aria-hidden="true">·</span>
          <span class="strip-item">Mock-up percuma sebelum cetak</span>
          <span class="marquee-dot" aria-hidden="true">·</span>
          <span class="strip-item">MOQ {SITE.moq} pcs sahaja</span>
          <span class="marquee-dot" aria-hidden="true">·</span>
          <span class="strip-item">Penghantaran seluruh Malaysia</span>
          <span class="marquee-dot" aria-hidden="true">·</span>
        </div>
      ))}
    </div>
  </div>

  <!-- NAVIGASI BAJET: pembeli pilih sendiri, tidak perlu skrol 9 seksyen -->
  <section class="section section-bajet">
    <div class="wrap">
      <div class="bajet-row">
        <p class="bajet-label">Mula dari bajet anda</p>
        <div class="bajet-chips">
          {[
            { nama: 'Bawah RM20', min: null, maks: 20 },
            { nama: 'RM20 – RM60', min: 20, maks: 60 },
            { nama: 'RM60 – RM150', min: 60, maks: 150 },
            { nama: 'RM150 ke atas', min: 150, maks: null },
          ].map((b) => (
            <a
              class="bajet-chip"
              href={pautan(`/katalog${b.min !== null || b.maks !== null
                ? `?${[b.min !== null ? `min=${b.min}` : '', b.maks !== null ? `maks=${b.maks}` : ''].filter(Boolean).join('&')}`
                : ''}`)}
            >
              {b.nama}
            </a>
          ))}
          <a class="bajet-chip bajet-semua" href={pautan('/katalog')}>Semua {produkSemua.length} produk →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUK PREMIUM -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Untuk majlis besar</p>
          <h2>Hadiah premium &amp; anugerah</h2>
          <p>Trofi kristal, plak, dan hadiah khas untuk menghargai klien utama.</p>
        </div>
      </div>
      <div class="grid-prod">
        {berharga.map((p) => <ProductCard p={p} ringkas />)}
      </div>
    </div>
  </section>

  <!-- KALKULATOR -->
  <section class="section section-dark">
    <div class="wrap calc">
      <div>
        <p class="eyebrow">Kalkulator bajet</p>
        <h2>Berapa sebenarnya kosnya?</h2>
        <p>
          Masukkan bilangan dan bajet seunit. Kami kira jumlah keseluruhan serta-merta —
          supaya anda tahu sebelum minta sebut harga.
        </p>
        <div class="note-box" style="margin-top:1.4rem">
          <b>Nota:</b> harga seunit biasanya turun bila bilangan naik. Minta sebut harga untuk
          harga sebenar pada bilangan anda.
        </div>
      </div>
      <div class="calc-form">
        <label for="k-bil" style="font-weight:600;font-size:.9rem">Bilangan (pcs)</label>
        <input class="input" id="k-bil" type="number" min="1" value="50" />
        <label for="k-bajet" style="font-weight:600;font-size:.9rem">Bajet seunit (RM)</label>
        <input class="input" id="k-bajet" type="number" min="1" value="30" step="0.5" />
        <div class="calc-out" style="margin-top:.6rem">
          <div class="lbl">Anggaran jumlah</div>
          <div class="val" id="k-jumlah">RM1,500.00</div>
          <p id="k-nota">Untuk 50 pcs pada RM30 seunit (harga asas produk). Cetakan logo dan penghantaran dinyatakan dalam sebut harga — anda nampak jumlah penuh sebelum membayar.</p>
          <a class="btn btn-lime" id="k-cari" href={pautan('/katalog')} style="margin-top:1rem;justify-content:center;width:100%">
            Tunjuk produk dalam bajet ini
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUK BAWAH RM60 -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bawah RM60</p>
          <h2>8 pilihan bawah RM60 seunit</h2>
          <p>Sesuai untuk sukan, seminar, dan hadiah kakitangan dalam bilangan besar.</p>
        </div>
        <a class="btn btn-ghost btn-sm" href={pautan('/katalog?maks=60')}>Lihat semua →</a>
      </div>
      <div class="grid-prod">
        {unggul.map((p) => <ProductCard p={p} ringkas />)}
      </div>
    </div>
  </section>

  <!-- KATEGORI -->
  <section class="section" id="kategori" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Kategori</p>
          <h2>Mula dari jenis hadiah</h2>
          <p>{kategori.length} kategori — pen, beg, trofi, mug, teknologi dan banyak lagi.</p>
        </div>
        <a class="btn btn-ghost btn-sm" href={pautan('/kategori')} style="border-color:var(--accent);color:var(--accent)">Semua kategori →</a>
      </div>
      <div class="cat-grid">
        {teratas.map((k) => (
          <a
            class="cat-card"
            href={pautan(`/kategori/${k.slug}`)}
            data-inisial={k.nama.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase()}
          >
            <img
              class="cat-img"
              onerror="this.closest('.cat-card').classList.add('img-gagal'); this.remove();"
              src={pautan(gambarKategori(k.nama, 400))}
              srcset={`${pautan(gambarKategori(k.nama, 400))} 400w, ${pautan(gambarKategori(k.nama, 800))} 800w`}
              sizes="(max-width: 640px) 45vw, (max-width: 1100px) 30vw, 240px"
              alt=""
              width="400"
                          height="400"
              loading="lazy"
              decoding="async"
            />
            <div class="cat-teks">
              <b>{k.nama}</b>
              <small>{k.bilangan} produk</small>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CARA PESAN -->
  <section class="section section-stone">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Cara pesan</p>
          <h2>Empat langkah, tiada borang panjang</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href={pautan('/cara-pesan')}>Perincian penuh →</a>
      </div>
      <div class="steps">
        <div class="step">
          <h3>Pilih produk</h3>
          <p>Tambah apa yang anda minat ke Senarai Sebut Harga — boleh campur kategori.</p>
        </div>
        <div class="step">
          <h3>Hantar senarai</h3>
          <p>Satu klik ke WhatsApp. Kami balas dengan harga sebenar ikut bilangan anda.</p>
        </div>
        <div class="step">
          <h3>Sahkan mock-up</h3>
          <p>Kami hantar gambar mock-up logo pada produk. Tiada caj, tiada komitmen.</p>
        </div>
        <div class="step">
          <h3>Cetak &amp; hantar</h3>
          <p>Selepas anda luluskan, kami cetak dan hantar ke pintu pejabat anda.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ULASAN PELANGGAN -->
  {ulasan.length > 0 && (
    <section class="section section-stone" id="ulasan">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Ulasan pelanggan</p>
            <h2>Apa kata mereka</h2>
            <p>Pengalaman pelanggan yang tempah hadiah korporat dengan kami.</p>
          </div>
        </div>
        <div class="ulasan-grid">
          {ulasan.map((u) => (
            <figure class="ulasan">
              <div class="ulasan-bintang" aria-label={`${u.bintang} daripada 5 bintang`}>
                {'★'.repeat(u.bintang)}<span class="kosong">{'★'.repeat(5 - u.bintang)}</span>
              </div>
              <blockquote>{u.teks}</blockquote>
              <figcaption>
                <b>{u.nama}</b>
                {(u.jawatan || u.syarikat) && (
                  <span>{[u.jawatan, u.syarikat].filter(Boolean).join(' · ')}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA AKHIR -->
  <section class="section section-dark">
    <div class="wrap narrow" style="text-align:center">
      <p class="eyebrow">Sedia mula?</p>
      <h2>Hantar senarai anda hari ini</h2>
      <p style="max-width:52ch;margin-inline:auto">
        Sebut harga dalam 1 hari kerja, barang siap 7–14 hari kerja selepas anda luluskan
        mock-up. Tiada bayaran pendahuluan sehingga mock-up diluluskan.
      </p>
      <div style="display:flex;gap:.7rem;justify-content:center;flex-wrap:wrap;margin-top:1.5rem">
        <a class="btn btn-lime" href={pautan('/katalog')}>Terokai {produkSemua.length} produk</a>
        <a class="btn btn-ghost-dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp terus</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Kalkulator bajet
    const bil = document.getElementById('k-bil');
    const bajet = document.getElementById('k-bajet');
    const jumlah = document.getElementById('k-jumlah');
    const nota = document.getElementById('k-nota');
    const cari = document.getElementById('k-cari');
    const asasCari = cari ? cari.getAttribute('href').split('?')[0] : '';

    function kira() {
      const b = Math.max(1, Number(bil.value) || 0);
      const h = Math.max(0, Number(bajet.value) || 0);
      jumlah.textContent = 'RM' + (b * h).toLocaleString('ms-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      nota.textContent = `Untuk ${b.toLocaleString('ms-MY')} pcs pada RM${h.toFixed(2)} seunit (harga asas produk). Cetakan logo dan penghantaran dinyatakan dalam sebut harga — anda nampak jumlah penuh sebelum membayar.`;
      if (cari && h > 0) cari.setAttribute('href', `${asasCari}?maks=${h}`);
    }
    bil?.addEventListener('input', kira);
    bajet?.addEventListener('input', kira);
    kira();

  </script>
</Base>
